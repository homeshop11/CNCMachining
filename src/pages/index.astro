---
import {
  ArrowRight,
  Award,
  CircleCheck,
  Clock3,
  Factory,
  MessageSquare,
  Ruler,
  ShieldCheck,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { advantages, certifications, equipment, productLines } from '../data/site';
---

<BaseLayout
  title="Lancoprecision | Precision CNC Machining and Sheet Metal"
  description="Precision CNC machining, turning, milling, five-axis work, and sheet metal fabrication for demanding B2B programs."
  currentPath="/"
>
  <section class="relative isolate min-h-[86svh] overflow-hidden bg-slate-950">
    <img
      src="/images/hero-cnc.jpg"
      alt="Five-axis CNC machine inside a precision manufacturing facility"
      class="absolute inset-0 h-full w-full object-cover opacity-70"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/75 to-slate-950/25"></div>

    <div class="page-shell relative z-10 flex min-h-[86svh] items-center py-20">
      <div class="max-w-3xl">
        <p class="eyebrow text-amber-400">Precision manufacturing partner</p>
        <h1 class="mt-5 text-5xl font-semibold leading-[1.02] text-white sm:text-6xl lg:text-7xl">
          Lancoprecision
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-200 sm:text-xl">
          CNC machining, turning, milling, five-axis work, and sheet metal fabrication with controlled tolerances, verified quality, and practical lead times.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/products/cnc-machining" class="btn-primary">
            Explore capabilities
            <ArrowRight size={17} aria-hidden="true" />
          </a>
          <a href="/contact" class="btn border border-white/35 bg-white/10 text-white hover:bg-white/20">
            Start an inquiry
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-slate-50">
    <div class="page-shell grid grid-cols-2 gap-px overflow-hidden lg:grid-cols-4">
      {
        [
          { value: '5', label: 'Core process lines' },
          { value: '+/- 0.005 mm', label: 'Critical feature control' },
          { value: '1 to 10,000+', label: 'Production batch range' },
          { value: '5 to 12 days', label: 'Typical machining lead time' },
        ].map((item) => (
          <div class="bg-slate-50 px-5 py-7 sm:px-6">
            <p class="text-2xl font-semibold text-brand-700">{item.value}</p>
            <p class="mt-1 text-sm text-slate-600">{item.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-pad">
    <div class="page-shell">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          eyebrow="Capabilities"
          title="Manufacturing options matched to the part, not the other way around."
          copy="Each process is supported by material guidance, inspection, and DFM review so the technical information needed for a decision is available before you contact us."
        />
        <a href="/about" class="btn-secondary hidden shrink-0 lg:inline-flex">
          View factory capability
          <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          productLines.slice(0, 3).map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        {
          productLines.slice(3).map((product) => (
            <ProductCard product={product} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-slate-950 py-16 text-white sm:py-20 lg:py-24">
    <div class="page-shell">
      <div class="max-w-3xl">
        <p class="eyebrow text-amber-400">Why Lancoprecision</p>
        <h2 class="mt-3 text-3xl font-semibold leading-tight text-white sm:text-4xl">
          Engineering and manufacturing controls that reduce sourcing risk.
        </h2>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          [
            { icon: Ruler, title: advantages[0].title, description: advantages[0].description },
            { icon: ShieldCheck, title: advantages[1].title, description: advantages[1].description },
            { icon: Clock3, title: advantages[2].title, description: advantages[2].description },
            { icon: MessageSquare, title: advantages[3].title, description: advantages[3].description },
          ].map((item) => (
            <div class="border-t border-white/15 pt-5">
              <item.icon size={24} class="text-amber-400" aria-hidden="true" />
              <h3 class="mt-5 text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-3 text-sm leading-6 text-slate-300">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-slate-100">
        <img
          src="/images/factory-floor.jpg"
          alt="Lancoprecision factory floor with precision machining equipment"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute bottom-4 left-4 flex items-center gap-2 rounded-md bg-slate-950/80 px-3 py-2 text-sm text-white">
          <Factory size={17} aria-hidden="true" />
          Factory floor
        </div>
      </div>

      <div>
        <p class="eyebrow">Factory capability</p>
        <h2 class="section-title">Calibrated equipment with in-process inspection.</h2>
        <p class="section-copy">
          The equipment list below represents the core machining and inspection assets used for prototype and production programs.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            equipment.map((item) => (
              <div class="flex gap-3 border-b border-slate-100 pb-4">
                <CircleCheck size={18} class="mt-0.5 shrink-0 text-brand-600" aria-hidden="true" />
                <div>
                  <p class="text-sm font-semibold text-slate-950">{item.name}</p>
                  <p class="mt-1 text-xs text-slate-500">{item.model} · {item.quantity} units</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20">
    <div class="page-shell">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading
          eyebrow="Certifications"
          title="Quality and compliance evidence."
          copy="Certification and compliance records are available for engineering and supplier review."
        />
        <Award size={46} class="hidden shrink-0 text-brand-700 lg:block" aria-hidden="true" />
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          certifications.map((cert) => (
            <div class="rounded-lg border border-slate-200 bg-white p-5">
              <ShieldCheck size={22} class="text-brand-600" aria-hidden="true" />
              <h3 class="mt-5 text-lg font-semibold text-slate-950">{cert.name}</h3>
              <p class="mt-1 text-sm text-slate-500">{cert.issuer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="page-shell grid gap-8 lg:grid-cols-[0.75fr_1.25fr]">
      <div class="max-w-xl">
        <p class="eyebrow">Start a project review</p>
        <h2 class="section-title">Send drawings, quantities, and target dates.</h2>
        <p class="section-copy">
          Use the form to start a technical review. This local development build records the submission without sending a live email.
        </p>
      </div>
      <InquiryForm compact />
    </div>
  </section>
</BaseLayout>
