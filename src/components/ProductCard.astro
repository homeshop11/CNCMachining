---
import { ArrowRight, Cog, Crosshair, Layers, RefreshCw, Slice } from '@lucide/astro';
import type { ProductLine } from '../data/site';

interface Props {
  product: ProductLine;
}

const { product } = Astro.props;

const icons = {
  cog: Cog,
  refresh: RefreshCw,
  slice: Slice,
  crosshair: Crosshair,
  layers: Layers,
};

const ProductIcon = icons[product.icon];
---

<article class="group overflow-hidden rounded-lg border border-slate-200 bg-white shadow-panel transition-transform duration-200 hover:-translate-y-1">
  <a href={`/products/${product.slug}`} class="block focus:outline-none">
    <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
      <img
        src={product.image}
        alt={product.imageAlt}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/55 to-transparent"></div>
      <div class="absolute bottom-4 left-4 flex h-10 w-10 items-center justify-center rounded-md bg-white/95 text-brand-700 shadow-sm">
        <ProductIcon size={20} aria-hidden="true" />
      </div>
    </div>

    <div class="p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="eyebrow">{product.shortName}</p>
          <h3 class="mt-2 text-xl font-semibold text-slate-950">{product.name}</h3>
        </div>
        <ArrowRight size={19} class="mt-1 shrink-0 text-slate-400 transition-colors group-hover:text-brand-600" aria-hidden="true" />
      </div>
      <p class="mt-3 text-sm leading-6 text-slate-600">{product.summary}</p>
      <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-xs text-slate-500">
        <span>Lead time</span>
        <span class="font-medium text-slate-700">{product.leadTime}</span>
      </div>
    </div>
  </a>
</article>
