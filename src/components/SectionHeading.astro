---
interface Props {
  eyebrow: string;
  title: string;
  copy?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, copy, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {copy && <p class="section-copy">{copy}</p>}
</div>
