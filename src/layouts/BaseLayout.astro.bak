---
import { MessageCircle } from '@lucide/astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import { getCompany, getProductLines } from '../lib/cms';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  image?: string;
}

const {
  title,
  description,
  currentPath = '/',
  image = '/images/hero-cnc.jpg',
} = Astro.props;

const company = await getCompany();
const productLines = await getProductLines();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    #<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-brand-700 focus:shadow-panel">
      Skip to content
    </a>
    <Header currentPath={currentPath} company={company} />
    <main id="main-content">
      <slot />
    </main>
    <Footer company={company} productLines={productLines} />

    <a
      href={`https://wa.me/${company.whatsapp}`}
      target="_blank"
      rel="noreferrer"
      class="fixed bottom-5 right-5 z-40 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-600 text-white shadow-panel transition-colors hover:bg-emerald-700"
      aria-label="Chat with Lancoprecision on WhatsApp"
    >
      <MessageCircle size={22} aria-hidden="true" />
    </a>
  </body>
</html>
